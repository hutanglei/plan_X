":false,"allow_all_stock":false,"stock_status_count":null,"domain":"","type":"1","province":"北京","city":"不限","gender":"m","status_count":1615,"last_status_id":411090819,"verified_description":"","verified_type":0,"step":"three","verified":false,"profile":"/1301462220","friends_count":50,"followers_count":8845,"location":"","description":"","id":1301462220,"url":"","status":1,"screen_name":"马靖昊说会计","following":false,"blocking":false,"donate_count":0,"name":"","verified_infos":null,"group_ids":null,"verified_realname":false,"name_pinyin":null,"screenname_pinyin":null,"photo_domain":"//xavatar.imedao.com/","live_info":{},"profile_image_url":"community/20127/1345372401181-20121221.png,community/20127/1345372401181-20121221.png!180x180.png,community/20127/1345372401181-20121221.png!50x50.png,community/20127/1345372401181-20121221.png!30x30.png"},"retweeted_status":null,"answers":null,"rqtype":null,"rqid":0,"target":"/1301462220/110955865","fragment":null,"blocked":false,"blocking":false,"topic_pic":null,"topic_symbol":null,"topic_title":null,"topic_desc":null,"donate_count":0,"donate_snowcoin":0,"liked":false,"view_count":0,"weixin_retweet_count":0,"mark":5,"card":null,"favorited":false,"favorited_created_at":null,"offer":null,"score":null,"controversial":false,"fundxHold":null,"tips":null,"stockCorrelation":[],"timeBefore":"2018-07-24 10:03","canEdit":true,"expend":true,"reward":false,"firstImg":null,"rawTitle":"长生生物疫苗毛利率达91.59%，巨额的销售费用中究竟藏了多少秘密？","tagStr":"","longTextForIOS":false,"topic_pic_thumbnail_small":null,"topic_pic_thumbnail":null,"topic_pic_headOrPad":null,"tagsForWeb":";","reply_count":8,"meta_keywords":null,"paid_mention":null,"reward_count":0,"reward_amount":0,"reward_user_count":0,"talk_count":0,"like_count":7,"video_info":null,"quote_cards":null,"promotion_pic":null,"promotion_url":null,"promotion_id":0,"mark_desc":null,"pic_sizes":[],"cover_pic_size":null,"order_id":0,"tags":[],"status_industry":null,"excellent_comments":[],"notice_tag":null,"common_emotion":null,"current_stock_price":null,"new_card":null,"source_deep_link":null,"source_feed":false,"editable":true,"like_config":null,"title_ad_pic":null,"title_ad_url":null,"title_ad_deep_link":null,"answer_comment":null,"answer_count":0,"answer_users":null,"bonus_screen_name":null,"fundx_tag":null,"extend_st_feed_info":{"stock_event_time":0,"stock_event_type":null,"change_event_color":null,"is_future_event":false,"stock_event_id":null,"stock_event_message":null,"original_text_length":1628,"disputed_status":false,"excellent_status":null},"stock_list":null,"reply_user_images":null,"reply_user_count":0,"fundx_symbol":null,"hot_new_rank":null,"image_info_list":null,"extend_st_home_page":{"ip_location":"","st_mention_stock_count":0,"ai_card":null,"ai_status":false,"speech_enable":false,"speech_info":null},"censor_state":0,"vod_info":null,"forbidden_retweet":false,"is_answer":false,"is_refused":false,"text":"<p><b>先给你们看个数据，</b>在疫苗行业排名前十的上市公司分别为长生生物、康泰生物、长春高新、双鹭药业、四环生物、安科生物、沃森生物、生物股份、康恩贝、广济药业，2018年一季度对应销售毛利率分别为91.59%、91.07%、89.37%、85.24%、81.69%、81.00%、78.21%、76.14%、75.26%、69.24%。<b>其中长生生物销售毛利率91.59%居第一，高于贵州茅台的91.31%。</b></p> <p><b>yan_mon：</b>医药行业毛利率远高于其他行业，说个更夸张的上市药企，我武生物，16年毛利率97.5%。</p> <p><b>马靖昊说会计：</b>定价真的很有问题，要问发改委和物价局的责！正是由于这些企业的高毛利率，才有巨额的销售费用，因为出得起这个钱。</p> <p><b>财报显示，2017年长生生物营业收入15.53亿元，研发投入仅1.22亿元，</b>那么，长生生物把钱都花哪了呢？其中的大头是销售费用——5.82亿元，占到营业收入的37.5%，是研发投入的近5倍，真可谓不惜花费重金，<b>更夸张的是比其利润5.66亿元还多出1600多万元。</b></p> <p>长生生物销售毛利率91.59%，销售费用率37.5%，<b>诸位朋友，这是一个什么概念？</b>这意味着出厂价为人民币100元的药品中，直接用在药品上的材料人工等各项生产成本只有8.41元钱，而用在行销上却高达是37.5元。也就是说，销售费用是药品直接成本的4倍还多。</p> <p>我再告诉大家，长生生物仅有25个销售人员，但2017年能花掉5.82亿元的销售费用，去年人均销售费用约<b>2331万元</b>，今年的数据也一样，一季度销售费用为1.17多亿元，平摊下来，每个人就“干掉”了约470万元，真要吓死宝宝了。<b>那么，巨额销售费用到底流向什么地方呢？</b></p> <p>对于销售费用的构成<b>，一般说得出来的，</b>包括市场推广、广告宣传、差旅费和会务费等；<b>一般说不出来的，</b>包括各种名义的公关费、佣金、回扣等。</p> <p>上述财报还显示，在长生生物的销售费用细项中，“推广服务费”占比逾七成。<b>2017年，长生生物的推广服务费为4.42亿元。</b>这些推广服务费多数是通过各种名义以礼品、旅游服务、代金卡甚至是现金的形式回馈给医生、医院、经销商等客户，<b>本质上就是一种变相的贿赂。</b></p> <p>另据报道，在疫苗销售的过程中，长生生物员工、经销商卷入到了多起刑事案件中。他们通过行贿有采购权限的相关部门，给予有关人员回扣的方式推销疫苗产品。中国裁判文书网显示，涉及长春长生的司法裁定书中，10余起均是通过回扣的方式行贿，所涉及的疫苗则包括狂犬、水痘、乙肝、流感等多种；其中，72元/支的冻干狂犬病疫苗其回扣额高达20元/支。</p> <p><b>这么高的毛利，在销售过程中大肆行贿，还要疫苗造假，良心何在！</b></p> <p><b>什么滴我：</b>医药行业的毛利率就是这么高，不这么高的话超高的销售费用怎么消化掉？！至于为什么有超高的销售费用，大家都懂得！</p> <p><b>马靖昊说会计：</b>现在知道老百姓看病难、看病贵了吧！关键这还不算，到头来，花钱还买假药，此事必须严查！追责到底！</p> <p><b>另外，我想告诉大家长生生物在研发方面的投入情况。企业毛利率高达91.59%，但依然在研发投入上很吝啬。</b>财报显示，2017年公司研发人员153人，研发投入资金为1.22亿元，占营业收入的7.87%，平均每人的研发费用79.73万元，诸位，请对比下上面提到的销售人员平均每人2328万元的销售费用，就可以发现公司用于疫苗研发的投入远远低于销售费用的投入。</p> <p>据统计，医疗保健行业290家医疗保健类上市公司，2017年销售费用高达1772亿元，同期的研发费用仅为319亿元，不足销售费用的五分之一。相关资料显示，2017年罗氏制药研发费用达115亿美元，国内290家医药企业2017年全部研发费用不足罗氏一半！</p> <p>这么多年来，医药行业流行的<b>“重销售轻研发病”</b>一直没有得到根治。依靠一味打广告，投入巨资搞营销，让这样的企业在医药行业大行其道，我国医药行业药品创新和原研之路将愈发艰难，<b>这必须深思！</b></p> <p>从奶粉到疫苗……为何一而再再而三地出现在中国？<b>是制造者的问题还是监管者的问题？</b></p> <p><b>带人血的馒头，好吃吗？</b></p>","show_cover_pic":true,"legal_user_visible":false,"is_column":true,"recommend_cards":null,"is_ss_multi_pic":false,"is_bonus":false,"cover_pic":"","pic":"","answer_question":false,"is_no_archive":false,"is_original_declare":true,"mp_not_show_status":false,"forbidden_comment":false,"is_private":false},"answers":null,"rqtype":null,"rqid":0,"target":"/1301462220/110956881","fragment":null,"blocked":false,"blocking":false,"topic_pic":null,"topic_symbol":null,"topic_title":null,"topic_desc":null,"donate_count":0,"donate_snowcoin":0,"liked":false,"view_count":0,"weixin_retweet_count":0,"mark":0,"card":null,"favorited":false,"favorited_created_at":null,"offer":null,"score":null,"controversial":false,"fundxHold":null,"tips":null,"stockCorrelation":[],"timeBefore":"2018-07-24 10:11","canEdit":true,"expend":false,"reward":false,"firstImg":null,"rawTitle":"","tagStr":"","longTextForIOS":false,"topic_pic_thumbnail_small":null,"topic_pic_thumbnail":null,"topic_pic_headOrPad":null,"tagsForWeb":"null;null","reply_count":0,"meta_keywords":null,"paid_mention":null,"reward_count":0,"reward_amount":0,"reward_user_count":0,"talk_count":1,"like_count":1,"video_info":nu