5f1a9493fea5528c.jpg","width":300,"height":184,"ocr_result":null},{"filename":"165aef2b6f0a7ce3fae314da.jpg","width":300,"height":144,"ocr_result":null},{"filename":"165aef2b814a7cf3fdf099dd.jpg","width":300,"height":126,"ocr_result":null},{"filename":"165aef2b917a78b3fc2e46ee.jpg","width":300,"height":126,"ocr_result":null},{"filename":"165aef2ba29a94a3fbe41545.jpg","width":300,"height":108,"ocr_result":null},{"filename":"165aef2bb2aa7d03fe3698ad.jpg","width":300,"height":140,"ocr_result":null},{"filename":"165aef2bc37a78c3fed0fa6c.jpg","width":22,"height":22,"ocr_result":null},{"filename":"165aef2bc37a78c3fed0fa6c.jpg","width":22,"height":22,"ocr_result":null},{"filename":"165aef2bdd8a94b3fcaf5f0d.jpg","width":22,"height":22,"ocr_result":null}],"extend_st_home_page":{"ip_location":"","st_mention_stock_count":7,"ai_card":null,"ai_status":false,"speech_enable":false,"speech_info":null},"censor_state":0,"forbidden_retweet":false,"pic":"https://xqimg.imedao.com/165aef2b27ba7883fdb13474.jpg,https://xqimg.imedao.com/165aef2b38aa9483fe5c5e8f.jpg,https://xqimg.imedao.com/165aef2b4e2a78a3feb78044.jpg,https://xqimg.imedao.com/165aef2b5f1a9493fea5528c.jpg,https://xqimg.imedao.com/165aef2b6f0a7ce3fae314da.jpg,https://xqimg.imedao.com/165aef2b814a7cf3fdf099dd.jpg,https://xqimg.imedao.com/165aef2b917a78b3fc2e46ee.jpg,https://xqimg.imedao.com/165aef2ba29a94a3fbe41545.jpg,https://xqimg.imedao.com/165aef2bb2aa7d03fe3698ad.jpg,https://xqimg.imedao.com/165aef2bc37a78c3fed0fa6c.jpg,https://xqimg.imedao.com/165aef2bc37a78c3fed0fa6c.jpg,https://xqimg.imedao.com/165aef2bdd8a94b3fcaf5f0d.jpg","vod_info":null,"recommend_cards":null,"show_cover_pic":true,"legal_user_visible":false,"is_answer":false,"is_refused":false,"is_column":false,"text":"<p>点击关注哟<img class=\"ke_img\" src=\"https://xqimg.imedao.com/165aef2b27ba7883fdb13474.jpg\" />每天学点会计</p> <p><b>【马靖昊有约】majinghao920<a href=\"https://xueqiu.com/n/qq\" target=\"_blank\">@qq</a>.com</b><b>财税微信公众号中首个超过100万人的社群！</b></p> <p><img class=\"ke_img\" src=\"https://xqimg.imedao.com/165aef2b38aa9483fe5c5e8f.jpg\" /></p> <p><b>一个女儿：招商银行</b></p> <p><img class=\"ke_img\" src=\"https://xqimg.imedao.com/165aef2b4e2a78a3feb78044.jpg\" /></p> <p>生女儿就像招商银行，取“招商”之意，生了女儿安心养，将来靠女婿赚钱养。</p> <p><b>一个儿子：建设银行</b></p> <p><img class=\"ke_img\" src=\"https://xqimg.imedao.com/165aef2b5f1a9493fea5528c.jpg\" /></p> <p>生儿子就像建设银行，取“建设”之意，生了儿子后要努力打拼，为儿子未来做准备，在上海娶老婆要花大钱的哦。</p> <p><b>一儿一女：平安银行</b></p> <p><img class=\"ke_img\" src=\"https://xqimg.imedao.com/165aef2b6f0a7ce3fae314da.jpg\" /></p> <p>有儿有女就像平安银行，取“平安”之意，养儿防老，有儿有女更是天伦之乐，妙不可言。</p> <p><b>两个女儿：浦发银行</b></p> <p><img class=\"ke_img\" src=\"https://xqimg.imedao.com/165aef2b814a7cf3fdf099dd.jpg\" /></p> <p>两个女儿就像浦发银行，取“普发”之意，招来两个金龟婿，还怕发不了财么！</p> <p><b>两个儿子：民生银行</b></p> <p><img class=\"ke_img\" src=\"https://xqimg.imedao.com/165aef2b917a78b3fc2e46ee.jpg\" /></p> <p>两个儿子就像民生银行，取“民生”之意，养儿防老是没错，但养两个儿子，你可要做好体会民生疾苦的准备。</p> <p><b>三个女儿：兴业银行</b></p> <p><img class=\"ke_img\" src=\"https://xqimg.imedao.com/165aef2ba29a94a3fbe41545.jpg\" /></p> <p>三个女儿就像兴业银行，取“兴业”之意，家族振兴指日可待！（政策允许再说吧）</p> <p><b>三个儿子：汇丰银行</b></p> <p><img class=\"ke_img\" src=\"https://xqimg.imedao.com/165aef2bb2aa7d03fe3698ad.jpg\" /> </p> <p>三个儿子就像汇丰银行，取“汇丰”之意，养太多儿子真的会（汇）疯（丰）掉的！</p> <p><b>我曾经在几年前就写过下面这条《生女儿是资产 生男孩是负债》的微博：</b></p> <p><b>生女儿是一项资产，它满足资产的三个条件：由过去的事项造成的，你拥有的，预期会给你带来经济利益的流入；生儿子是一项负债，它满足负债的三个条件：由过去事项造成，你需要履行的现时义务，最终会导致你的经济利益流出。</b></p> <p><b>Visiblewings周亚雄：</b>次奥！完美解说资产和负债！<img class=\"ke_img\" src=\"https://xqimg.imedao.com/165aef2bc37a78c3fed0fa6c.jpg\" /></p> <p><b>江念大爷：</b>看完这段儿，资产、负债的定义也记住了，哈哈哈。</p> <p><b>小丫嘛小会计:</b> 哈哈 这个解释太牛了 不愧是大牛马老师<img class=\"ke_img\" src=\"https://xqimg.imedao.com/165aef2bc37a78c3fed0fa6c.jpg\" />仔细想想 还真是 女孩子长大了 自己赚钱了 总会想给爸妈买各种东西 这就是预期会有经济利益流入<img class=\"ke_img\" src=\"https://xqimg.imedao.com/165aef2bdd8a94b3fcaf5f0d.jpg\" />男孩子的话 一个房子问题 就购愁人了 果真是负债。</p> <p><b>八月之陌：</b>非常赞同。至少，毕业后，我没向父母拿过钱，过年还会给父母钱；而我弟弟，房子、彩礼、办酒席，都是现金流出啊！</p> <p><b>YSYCW：</b>有人说生个女孩会多个儿子，生个男孩，儿子没了，还要搭一套房子。[哈哈][哈哈]</p> <p><b>马靖昊说会计：</b>再看看目前坑爹的社会现象，也可佐证：女孩要是坑爹，坑的都是干爹，表外；男孩要是坑爹，坑的都是亲爹，表内。从坑爹的角度，还是生女孩好，要坑就坑表外的爹！</p>","is_ss_multi_pic":false,"is_bonus":false,"cover_pic":"","answer_question":false,"is_no_archive":false,"is_original_declare":false,"mp_not_show_status":false,"forbidden_comment":false,"is_private":false}