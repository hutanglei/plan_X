g","width":600,"height":200,"ocr_result":null},{"filename":"17406ea4741524f3fd57c305.png","width":600,"height":200,"ocr_result":null}],"extend_st_home_page":{"ip_location":"","st_mention_stock_count":1,"ai_card":null,"ai_status":false,"speech_enable":false,"speech_info":null},"censor_state":0,"recommend_cards":null,"forbidden_retweet":false,"pic":"https://xqimg.imedao.com/17406ea3e1f51cf3f8c963d9.jpeg!thumb.jpg,https://xqimg.imedao.com/17406ea3fcc51dc3fdfb4269.jpeg!thumb.jpg,https://xqimg.imedao.com/17406ea41d052713fe2296cc.jpeg!thumb.jpg,https://xqimg.imedao.com/17406ea435f515f3fe7e0d1d.jpeg!thumb.jpg,https://xqimg.imedao.com/17406ea44c951453fe8aa859.png!thumb.jpg,https://xqimg.imedao.com/17406ea4741524f3fd57c305.png!thumb.jpg","vod_info":null,"is_answer":false,"is_refused":false,"text":"<p>小福利，发送“819”获取为您定制的财务日历</p> <p><img class=\"ke_img\" src=\"https://xqimg.imedao.com/17406ea3e1f51cf3f8c963d9.jpeg!custom.jpg\" /></p> <p>8月18日，上市公司康宏环球发布了《核数师辞任》。</p> <p>公告显示：罗兵咸永道获委聘对二零一七年财务报表进行审计。<b>然而，自罗兵咸永道获委聘以来已经过去30个月，并已产生大量专业费用，但二零一七年财务报表仍尚未落实。</b>由于罗兵咸永道无法承诺落实二零一七年财务报表的明确时间表，且董事会尚不明确该程序将会产生的额外专业费用的数额，董事会认为<b>邀请</b><b>罗兵咸永道考虑辞任核数师符合本公司及其股东的最佳利益。</b></p> <p>详细公告如下：</p> <p><img class=\"ke_img\" src=\"https://xqimg.imedao.com/17406ea3fcc51dc3fdfb4269.jpeg!custom.jpg\" /></p> <p><img class=\"ke_img\" src=\"https://xqimg.imedao.com/17406ea41d052713fe2296cc.jpeg!custom.jpg\" /></p> <p>根据公司2016年年报披露，该公司2016年共支付给<b>安永4,528,000港元（折合人民币约404万元，其中审计费用约357万元）。</b></p> <p><img class=\"ke_img\" src=\"https://xqimg.imedao.com/17406ea435f515f3fe7e0d1d.jpeg!custom.jpg\" /></p> <p>用精炼的语言阐述深刻的财务逻辑，如文章得到您的认可，<b>希望您看完后分享到“朋友圈”或者点一下右下角的“在看”</b>，以示鼓励。长期坚持不易，多次想放弃，坚持是一种信仰，专注是一种态度 ，一路陪伴，一起地老天荒，谢谢。</p> <p><b>推荐阅读</b></p> <p><img class=\"ke_img\" src=\"https://xqimg.imedao.com/17406ea44c951453fe8aa859.png!custom.jpg\" /></p> <p><img class=\"ke_img\" src=\"https://xqimg.imedao.com/17406ea4741524f3fd57c305.png!custom.jpg\" /></p> <p>小福利，发送<b>“819”</b>获取为您定制的<b>财务日历</b></p>","show_cover_pic":true,"legal_user_visible":false,"is_column":false,"is_ss_multi_pic":false,"is_bonus":false,"cover_pic":"","is_original_declare":false,"mp_not_show_status":false,"forbidden_comment":false,"answer_question":false,"is_no_archive":false,"is_private":false}