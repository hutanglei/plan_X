f5db7090.png","width":64,"height":64,"ocr_result":null},{"filename":"1742ae1072252203fe0ebd15.png","width":600,"height":200,"ocr_result":null},{"filename":"1742ae109b5532e3fa09827a.png","width":600,"height":200,"ocr_result":null}],"extend_st_home_page":{"ip_location":"","st_mention_stock_count":0,"ai_card":null,"ai_status":false,"speech_enable":false,"speech_info":null},"censor_state":0,"pic":"https://xqimg.imedao.com/1742ae0fdf552363fe5974f6.png!thumb.jpg,https://xqimg.imedao.com/1742ae1013052863fd9f8569.jpeg!thumb.jpg,https://xqimg.imedao.com/1742ae1029f52373f5db7090.png,https://xqimg.imedao.com/1742ae1038e50923f9e22024.png!thumb.jpg,https://xqimg.imedao.com/1742ae10480520c3fc4ddab8.png!thumb.jpg,https://xqimg.imedao.com/1742ae1029f52373f5db7090.png!thumb.jpg,https://xqimg.imedao.com/1742ae1072252203fe0ebd15.png!thumb.jpg,https://xqimg.imedao.com/1742ae109b5532e3fa09827a.png!thumb.jpg","forbidden_retweet":false,"recommend_cards":null,"vod_info":null,"is_answer":false,"is_refused":false,"text":"<p>小福利，发送“826”获取为您定制的财务日历</p> <p><img class=\"ke_img\" src=\"https://xqimg.imedao.com/1742ae0fdf552363fe5974f6.png!custom.jpg\" /></p> <p><b>收听文章音频</b></p> <p><b>（一）</b></p> <p><b>谈然从容的乌镇：</b>老马，请教个问题。连续编制合并报表时，为什么要将上期抵消的内部应收账款计提的坏账准备抵消？</p> <p><img class=\"ke_img\" src=\"https://xqimg.imedao.com/1742ae1013052863fd9f8569.jpeg!custom.jpg\" /></p> <p><b>【用刘欢的《从头再来》解说连续编制合并报表】</b>昨天所有的记录，已变成遥远的回忆(合并分录是暂时性的)，勤勤苦苦已编过合并，今夜重又走入风雨(每一年要重新编制)。我不能独自披露，为了我至爱的伙伴，再苦再难也要并表，只为那些期待眼神，心若在梦就在，天地之间还有真爱，看编制合并报表，只不过是从头再来。</p> <p><b>立夏寒梅：</b><img class=\"ke_img\" src=\"https://xqimg.imedao.com/1742ae1029f52373f5db7090.png\" />这个太精辟了，从头再来……</p> <p><b>synergrator:</b> 马老师是把会计吃透了啊。</p> <p><b>马靖昊: </b><b>是刘欢将合并报表吃透了，还唱出来了！</b></p> <p><b>叶子-芊芊：</b>马老师这思维跳跃得太厉害了，您原来是娱乐圈的吧，跨界太大<img class=\"ke_img\" src=\"https://xqimg.imedao.com/1742ae1038e50923f9e22024.png!custom.jpg\" /></p> <p><b>马靖昊：</b>难道大家每一年编制合并报表不是从头再来吗？因为它是没有账的，只有抵销分录，每一年就只好从头再来了。</p> <p><b>（二）</b></p> <p><b>【用《春天里》的歌词说会计】</b></p> <p><b>现金流量表：</b>“如果有一天我(现金支出)悄然离去,请把我埋在在这春天里(现金流量表)”；</p> <p><b>资产负债表：</b>“也许有一天我(资本化支出)老无所依,请把我留在在那时光里(资产负债表)”；</p> <p><b>利润表：</b>如果有一天我(费用化支出,资产折旧和摊销)悄然离去,请把我埋在在这春天里(利润表)”。</p> <p><b>纳米布東丶：</b>最近在学到固定资产后续计量，里面涉及到资本化支出和费用化支出，很形象到位。</p> <p><b>艾耀慧:</b>佩服！境界！割开血管，血液里流淌的都是专业。膜拜马老师！</p> <p><b>羽立舟：</b>神思维。</p> <p><b>马靖昊：</b>不管你是资本化支出还是费用化支出，都在作为现金支出埋在现金流量表里。</p> <p><b>（三）</b></p> <p><b>一开始谈恋爱时，女人最关心的是男人的现金流量表，</b>谈了一段时间，处出了感情，女人开始关心男人的利润表，也试着体量男人创造利润的艰难，到最后决定嫁给这个男人时，主要还是要看这个男人的主表资产负债表了。</p> <p><b>Peter_一直在路上:</b>马老师不光研究会计，对社会科学也有相当造诣，认同你的分析，身边多数人都是按此方式走进“坟墓”的。</p> <p><b>马靖昊: </b>女人恋爱思维进化：现金流量表→利润表→资产负债表。</p> <p>木木妈妈2032896635：<img class=\"ke_img\" src=\"https://xqimg.imedao.com/1742ae10480520c3fc4ddab8.png!custom.jpg\" /><img class=\"ke_img\" src=\"https://xqimg.imedao.com/1742ae1029f52373f5db7090.png!custom.jpg\" /></p> <p>马靖昊：你这么问，那我也只好再写一段了。</p> <p><b>一开始谈恋爱时，男人最关心的是女人的资产负债表，</b>也就是看看包括形象、气质、教养在内的无形资产竟然如何，谈了一段时间，处出了感情，男人开始关心女人的利润表，也就是关心她的身体冷暖、健康状况，到最后决定娶这个女人时，就决定为她的现金流量表注入源源不断的现金流。</p> <p><b>（四）</b></p> <p><b>【存货高估低估调控利润的路径】</b>可供出售存货(期初存货+本期增加)－本期减少＝期末存货；可供出售存货→ 已出售→ 销售成本→ 利润表；可供出售存货→ 未出售→ 期末存货→ 资产负债表；期初存货高估或期末存货低估→ 销售成本高估，利润低估；期初存货低估或期末存货高估→ 销售成本低估，利润高估。</p> <p>大家看出来了没有，调控利润，实际上就是在资产负债表和利润表之间打转转。</p> <p><b>增加盈利的方法：</b>1.提早确认收入或干脆虚增收入；2.将更多的费用以资本化的方式计入资产负债表。</p> <p><b>减少盈利的方法：</b>1.将更多的收入以预计的方式计入资产负债表；2.将更多的资产以折旧、减值的形式尽快计入利润表。大道至简：会计魔术就这么简单。</p> <p><b>（五）</b></p> <p><b>你发现了么，那些喜欢你的人会变得越来越好看；</b>而那些不喜欢你的人，都长得越来越丑……。其实，这个问题在会计上很好解释，那些喜欢你的人，你对他是评估增值，而对那些不喜欢你的人，你对他是减值测试，计提减值准备。</p> <p><b>Euran:</b>呵呵 在马老师这里会计成了给人智慧的科学了。</p> <p><b>马靖昊:</b>会计也是哲学！</p> <p>用精炼的语言阐述深刻的财务逻辑，如文章得到您的认可，<b>希望您看完后分享到“朋友圈”或者点一下右下角的“在看”</b>，以示鼓励。长期坚持原创不易，多次想放弃，坚持是一种信仰，专注是一种态度 ，一路陪伴，一起地老天荒，谢谢。</p> <p><b>推荐阅读</b></p> <p><img class=\"ke_img\" src=\"https://xqimg.imedao.com/1742ae1072252203fe0ebd15.png!custom.jpg\" /></p> <p><img class=\"ke_img\" src=\"https://xqimg.imedao.com/1742ae109b5532e3fa09827a.png!custom.jpg\" /></p> <p>小福利，发送<b>“826”</b>获取为您定制的<b>财务日历</b></p>","show_cover_pic":true,"legal_user_visible":false,"is_column":false,"is_ss_multi_pic":false,"is_bonus":false,"cover_pic":"","answer_question":false,"is_no_archive":false,"is_original_declare":false,"mp_not_show_status":false,"forbidden_comment":false,"is_private":false}