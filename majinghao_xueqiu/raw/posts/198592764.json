{"id":198592764,"user_id":1301462220,"source":"雪球","title":"关于将会计纳入2万元人才奖励名单的通知......","created_at":1632406831000,"retweet_count":0,"fav_count":0,"truncated":false,"commentId":0,"retweet_status_id":0,"symbol_id":null,"description":"  深圳注协发布特别通知！  <br/>\n  政府将CPA纳入人才奖励范围  <br/>\n深圳市注册会计师协会发布了一条消息——福田区政府将注册会计师纳入人才奖励范围。深圳注协在通知中表示：这体现了注册会计师行业的含金量与证书权威性。<br/>通知原文如下：<br/>\n9月17日，福田区人才新政发布新闻通...","type":"3","source_link":null,"edited_at":null,"user":{"subscribeable":false,"common_count":0,"remark":"","recommend_reason":null,"domain":"","type":"1","recommend":null,"st_color":"1","intro":null,"follow_me":false,"allow_all_stock":false,"stock_status_count":null,"blog_description":"","stocks_count":5,"friends_count":50,"location":"","description":"","id":1301462220,"url":"","status":1,"followers_count":8831,"status_count":1603,"verified":false,"profile":"/1301462220","province":"北京","city":"不限","gender":"m","last_status_id":409123261,"verified_description":"","verified_type":0,"step":"three","following":false,"screen_name":"马靖昊说会计","blocking":false,"donate_count":0,"name":"","verified_infos":null,"group_ids":null,"verified_realname":false,"name_pinyin":null,"screenname_pinyin":null,"photo_domain":"//xavatar.imedao.com/","live_info":{},"profile_image_url":"community/20127/1345372401181-20121221.png,community/20127/1345372401181-20121221.png!180x180.png,community/20127/1345372401181-20121221.png!50x50.png,community/20127/1345372401181-20121221.png!30x30.png"},"retweeted_status":null,"answers":null,"rqtype":null,"rqid":0,"target":"/1301462220/198592764","fragment":null,"blocked":false,"blocking":false,"topic_pic":null,"topic_symbol":null,"topic_title":null,"topic_desc":null,"donate_count":0,"donate_snowcoin":0,"liked":false,"view_count":0,"weixin_retweet_count":0,"mark":0,"card":null,"favorited":false,"favorited_created_at":null,"offer":null,"score":null,"controversial":false,"fundxHold":null,"tips":null,"stockCorrelation":[],"timeBefore":"2021-09-23 22:20","canEdit":true,"expend"