"183a31c365c9c473fe980dcd.png","width":1048,"height":647,"ocr_result":null},{"filename":"183a31ca67c9de93fdf2ea9e.png","width":700,"height":458,"ocr_result":null},{"filename":"183a31caffb9c483fc5b3b6a.png","width":582,"height":242,"ocr_result":null},{"filename":"183a31cb60e9dea3fee4c01d.png","width":548,"height":354,"ocr_result":null},{"filename":"183a31cbcd79e403fc9ab5f1.png","width":536,"height":316,"ocr_result":null},{"filename":"183a31d2a729e433fe36d980.png","width":873,"height":251,"ocr_result":null},{"filename":"183a31d33949c4b3fdaff06b.png","width":755,"height":503,"ocr_result":null},{"filename":"183a31d3c3d9cce3feca1040.png","width":1080,"height":466,"ocr_result":null},{"filename":"183a31d59109c9a3fefbe2c8.png","width":1080,"height":545,"ocr_result":null},{"filename":"183a31d62929c433fdb3fc80.jpeg","width":851,"height":322,"ocr_result":null},{"filename":"183a31d68c39c443fd11558a.jpeg","width":571,"height":216,"ocr_result":null},{"filename":"183a31d6f769c2b3fd45bbfd.jpeg","width":596,"height":318,"ocr_result":null},{"filename":"183a31d768b9c453fe2b32cb.jpeg","width":578,"height":327,"ocr_result":null},{"filename":"183a31d7f339c4d3fca914e7.jpeg","width":556,"height":373,"ocr_result":null},{"filename":"183a31d87559e463fdfb8636.jpeg","width":556,"height":264,"ocr_result":null},{"filename":"183a31d8e789c2c3fdfb9c8c.png","width":747,"height":429,"ocr_result":null},{"filename":"183a31d94c19c463fdb750e4.png","width":659,"height":583,"ocr_result":null},{"filename":"183a31d9df09dee3f93fd8ca.png","width":780,"height":276,"ocr_result":null},{"filename":"183a31dd9f89df03feef652e.png","width":568,"height":375,"ocr_result":null}],"extend_st_home_page":{"ip_location":"","st_mention_stock_count":2,"ai_card":null,"ai_status":false,"speech_enable":false,"speech_info":null},"censor_state":0,"show_cover_pic":true,"legal_user_visible":false,"forbidden_retweet":false,"pic":"https://xqimg.imedao.com/183a31c236d9e5c3fdc05757.png,https://xqimg.imedao.com/183a31c365c9c473fe980dcd.png,https://xqimg.imedao.com/183a31ca67c9de93fdf2ea9e.png,https://xqimg.imedao.com/183a31caffb9c483fc5b3b6a.png,https://xqimg.imedao.com/183a31cb60e9dea3fee4c01d.png,https://xqimg.imedao.com/183a31cbcd79e403fc9ab5f1.png,https://xqimg.imedao.com/183a31d2a729e433fe36d980.png,https://xqimg.imedao.com/183a31d33949c4b3fdaff06b.png,https://xqimg.imedao.com/183a31d3c3d9cce3feca1040.png,https://xqimg.imedao.com/183a31d59109c9a3fefbe2c8.png,https://xqimg.imedao.com/183a31d62929c433fdb3fc80.jpeg,https://xqimg.imedao.com/183a31d68c39c443fd11558a.jpeg,https://xqimg.imedao.com/183a31d6f769c2b3fd45bbfd.jpeg,https://xqimg.imedao.com/183a31d768b9c453fe2b32cb.jpeg,https://xqimg.imedao.com/183a31d7f339c4d3fca914e7.jpeg,https://xqimg.imedao.com/183a31d87559e463fdfb8636.jpeg,https://xqimg.imedao.com/183a31d8e789c2c3fdfb9c8c.png,https://xqimg.imedao.com/183a31d94c19c463fdb750e4.png,https://xqimg.imedao.com/183a31d9df09dee3f93fd8ca.png,https://xqimg.imedao.com/183a31dd9f89df03feef652e.png","recommend_cards":null,"vod_info":null,"is_answer":false,"is_refused":false,"text":"<p><b> 点击下方卡片关注我 </b></p> <p>       <b>近日，高等教育专业评价机构软科正式发布“2022软科中国财经类大学排名”！</b><b>引发财经圈的关注。</b></p>  <p><b>软科财经大学榜单公布</b></p> <p><b>上海财经大学位居第一</b></p> <p>2022软科中国财经类大学排名的上榜高校有<b>55</b>所，<b>上海财经大学、中央财经大学、对外经济贸易大学、中南财经政法大学、西南财经大学</b>位列前五，东北财经大学位居第六位。</p> <p>五财一贸牢牢占据了榜单前六的位置。</p>  <p><b>对比2021年的数据：</b></p>  <p><b>五财一贸继续占据榜单前六。</b></p> <p>不过江西财经大学成为了今年的大黑马，反超首都经济贸易大学和浙江工商大学，位居第7位，成为了最接近五财一贸的存在。</p> <p>南京财经大学入围软科财经类大学前10，较2021年上升2位！</p> <p>武汉商学院成为入围榜单前600，排名599位，较2021年提升明显！</p> <p>2022软科中国大学排名”的对象是中国1000多所本科层次的高校，具体评价标准如下：</p>  <p>从软科的评价标准看，研本比、本专比、教师的学历结构和职称结构、杰出校友、国际科研项目（师均）、高端人才、生源质量、国家重大项目和教育部奖励，这几各指标在财经类大学的排名中有着非常重要的作用。</p> <p>其中生源质量＞杰出校友＞高端人才＞国际科研项目（师均）=国家重大项目=教育部奖励=教师的学历结构和职称结构=研本比。</p>  <p><b>“五财一贸”的就业情况</b></p> <p>总的来说，无论是师资力量、生源质量还是杰出校友数量、研本比等，五财一贸都牢牢占据榜单的前列，<b>也就是中南财经政法大学、中央财经大学、上海财经大学、西南财经大学、东北财经大学和对外经济贸易大学</b><b>。</b></p> <p>他们分散在全国各地，代表了财经大学的最高水平，一定程度上可以反映我们的财经大学的发展状况，</p> <p><b>最新版的就业情况给大家整理出来了，看看经过一年的角逐和市场变化，五财一贸的就业情况如何?</b></p> <p><b>1、上海财经大学</b></p> <p>2021年上海财经大学毕业去向落实率为94.69%，其中选择国内单位就业的达到了70.90%，国内升学的15.35%，剩下还有8.44%选择了出国升学或者就业。</p> <p><img class=\"ke_img\" src=\"https://xqimg.imedao.com/183a31c236d9e5c3fdc05757.png\" /></p> <p>选择国内就业的学生中，本科只占41.05%，硕士和博士分别占93.70%和96.92%。</p> <p><img class=\"ke_img\" src=\"https://xqimg.imedao.com/183a31c365c9c473fe980dcd.png\" /></p> <p>流向最多的五个行业是银行、证券、<a href=\"https://xueqiu.com/S/CSIH30182?from=status_stock_match\" class=\"xq_stock\">计算机</a>、教育科研还有会计师事务所。</p> <p>其中本科学生最多的流向会计师事务所，占比19.64%；</p> <p>硕士最多的流向证券和银行，均占15%左右</p> <p>博士流向最多的是教育科研机构，达到了59.35%</p>  <p>从行业角度看，金融大类依然是上财学生流向最多的行业，同时银行依然是金融大类细分中流向最多的行业。</p>  <p><b>2、中央财经大学</b></p> <p><b>2020 届央财本科生整体就业率为86.71%</b><b>， 硕士生整体就业率96.3%，博士生就业率为98.11%。</b></p> <p><img class=\"ke_img\" src=\"https://xqimg.imedao.com/183a31ca67c9de93fdf2ea9e.png\" /></p> <p>薪酬方面，毕业生平均期望起薪为10027.68/月，<b>实际获得的平均起薪为9674.22/月</b>。其中研究者起薪稍高，达到10238.84元/月，本科生则为7887.29元/月。</p> <p><img class=\"ke_img\" src=\"https://xqimg.imedao.com/183a31caffb9c483fc5b3b6a.png\" /></p> <p><img class=\"ke_img\" src=\"https://xqimg.imedao.com/183a31cb60e9dea3fee4c01d.png\" /></p> <p><img class=\"ke_img\" src=\"https://xqimg.imedao.com/183a31cbcd79e403fc9ab5f1.png\" /></p> <p><b>3、对外经贸大学</b></p> <p>2021 届毕业生<b>总体落实率为96.07%</b>，本科生落实率92.98%，硕士生落实率98.58%。</p>  <p>就业单位主要集中在<a href=\"https://xueqiu.com/S/SH510650?from=status_stock_match\" class=\"xq_stock\">金融行业</a>，占本科生的18.36%、硕士生的43.08%，本科和硕士阶段最偏向银行业，博士生最偏向于证券业。</p>  <p>另外，2021年对外经贸大学毕业生中有超过四分之一进入了世界500强。</p> <p><img class=\"ke_img\" src=\"https://xqimg.imedao.com/183a31d2a729e433fe36d980.png\" /></p> <p>其中对外经贸大学毕业生最偏好的企业是中信集团。</p> <p><img class=\"ke_img\" src=\"https://xqimg.imedao.com/183a31d33949c4b3fdaff06b.png\" /></p> <p>对外经济贸易大学<b>毕业生平均薪资为11032元/月</b>，位于2021年各财经大学之首。</p> <p><b>4、中南财经政法大学</b></p> <p><b>2020 届毕业生整体就业率 90.92 %，</b> 其中本科毕业生就业率为 87.85%， 硕士毕业生就业率为 95.76 %， 博士毕业生就业率为99.26%。</p> <p><img class=\"ke_img\" src=\"https://xqimg.imedao.com/183a31d3c3d9cce3feca1040.png\" /></p> <p><b>就业行业集中在“金融业”，</b> 其次为“信息传输、 软件和信息技术服务业”、 “公共管理、 社会保障和社会组织” 和“教育” 领域。</p> <p><img class=\"ke_img\" src=\"https://xqimg.imedao.com/183a31d59109c9a3fefbe2c8.png\" /></p> <p><b>薪酬方面，2020 届毕业生月均收入为 7693.15 元。</b>月薪区间主要集中在 5000（含） -7000 元 ， 其次为 10000 元及以上和 8000（含） -10000 元。<b>本科毕业生月均收入为6879.47元，毕业研究生月均收入为8279.17元。</b></p> <p><img class=\"ke_img\" src=\"https://xqimg.imedao.com/183a31d62929c433fdb3fc80.jpeg\" /></p> <p><b>5、西南财经大学</b></p> <p>截至 2021年11 月 30日，毕业去向落实率为 93%。本科、硕士、博士分别为 91.83%、93.94%、95.72%。</p> <p>从毕业去向看：</p> <p>本科选择升学的人数最多，达到了41.02%</p> <p>硕士和博士选择协议合同就业的人数最多，分别占78.04%和85.47%。</p> <p><img class=\"ke_img\" src=\"https://xqimg.imedao.com/183a31d68c39c443fd11558a.jpeg\" /></p> <p>从就业行业类型看</p> <p>本科就业去向最多的行业是金融业，占比27.77%，其次是信息技术服务行业，占比11.06%；</p> <p>硕士去向最多的也是金融业，占比37.20%，其次是公共管理、社会保障和社会组织；</p> <p>博士去向最多的是教育业，占比81%。</p> <p><img class=\"ke_img\" src=\"https://xqimg.imedao.com/183a31d6f769c2b3fd45bbfd.jpeg\" /></p> <p>从企业类型看，国有企业和民营企业占比最高，分别达到了37.9%和37.68%。</p> <p><img class=\"ke_img\" src=\"https://xqimg.imedao.com/183a31d768b9c453fe2b32cb.jpeg\" /></p> <p><b>6、东北财经大学</b></p> <p>2019届本科毕业生就业率为96.06%，毕业研究生就业率为96.21%。</p> <p>2019届本科毕业生就业的行业分布较为广泛。信息传输、软件和信息技术服务业、金融业、租赁和商业服务业就业人数相对较多。</p> <p><img class=\"ke_img\" src=\"https://xqimg.imedao.com/183a31d7f339c4d3fca914e7.jpeg\" /></p> <p>该校2019届毕业研究生从签约单位行业分布来看，主要集中在金融业，信息传输、软件和信息技术服务业及租赁和商业服务业。</p> <p><img class=\"ke_img\" src=\"https://xqimg.imedao.com/183a31d87559e463fdfb8636.jpeg\" /></p>  <p><b>其他财经类大学的表现</b></p> <p>虽然五财一贸是财经类大学的代表性院校，但是还有一些财经院校同样不逞多让。</p> <p><b>首先是这次位列第7的江西财经大学。</b></p> <p><img class=\"ke_img\" src=\"https://xqimg.imedao.com/183a31d8e789c2c3fdfb9c8c.png\" /></p> <p>2021年江西财经大学毕业生毕业去向落实人数为6720人，经省教育厅、省人社厅核准后公布的毕业去向落实率为93.79%。其中，本科毕业生毕业去向落实4857人，初次毕业去向落实率为92.94%；研究生毕业生毕业去向落实1863人，初次毕业去向落实率为96.08%。</p> <p>其中，本科毕业生主要毕业去向为：国内升学深造(1936人，37.05%)、签就业协议形式就业(1756人，33.60%)、出国(境)(409人，7.83%)；</p> <p>研究生毕业生主要毕业去向为签就业协议形式就业(971人，50.08%)、签劳动合同形式就业(384人，19.80%)、其他录用形式就业(360人，18.57%)。</p> <p>从流向行业看，金融业占比最高，为20.82%，其次为制造业13.35%。</p> <p><img class=\"ke_img\" src=\"https://xqimg.imedao.com/183a31d94c19c463fdb750e4.png\" /></p> <p>其中本科流向制造业占比更高一些，研究生主要是金融业，其次是公共管理、社会保障和社会组织。</p> <p>从事务所的流向看，江财学子最多的是去往了天健会计师事务所，其次是容诚和致同。</p> <p><img class=\"ke_img\" src=\"https://xqimg.imedao.com/183a31d9df09dee3f93fd8ca.png\" /></p> <p><b>另外，上海对外经贸大学近几年的势头也十分的强劲。</b></p> <p>对照中国薪酬网发布的《2021年全国高校毕业生薪酬排行榜TOP100》，我们发现，对外经贸大学在财经类院校薪酬排名中，位列第一，毕业生平均薪酬11032元/月，其次是中央财经大学，为10162元，<b>而上海对外经贸排名第三。</b></p> <p>以下为具体榜单：</p>  <p>2021年上海对外经贸大学毕业生平均薪酬达到了10066元。</p> <p><img class=\"ke_img\" src=\"https://xqimg.imedao.com/183a31dd9f89df03feef652e.png\" /></p> <p>从毕业生就业分布看，上海对外经贸大学大部分毕业生都会留在上海工作，这也是总体薪资水平比较高的原因之一。</p> <p>另外，大部分上海对外经贸的毕业生都受到会计事务所、金融机构和咨询机构的青睐，四大会计师事务所均是2021届应届生的主要流向企业。</p>  <p>总的说来，五财一贸的毕业生在薪酬上更有优势，但是整体薪酬状况不仅仅取决于院校本身，还受到院校所处的位置、毕业生的就业流向以及他们往后的努力。</p> <p>所以，<b>努力＞天赋，而选择＞努力。</b></p> <p><b>无论我们的起点如何，一定要保持终身学习的习惯，确定好自己的职业发展规划，相信天道酬勤，努力终究会被人看到。</b></p>  <p>来源:直通四大整理自软科、五财一贸就业质量报告、江西财经大学就业质量报告！</p> <p>用精炼的语言阐述深刻的财务逻辑，如文章得到您的认可，<b>希望您看完后分享到“朋友圈”或者点一下右下角的“在看”，</b>以示鼓励。长期坚持不易，多次想放弃，坚持是一种信仰，专注是一种态度 ，一路陪伴，一起地老天荒，谢谢。</p> <p></p> <p><b>推荐阅读</b></p> <p>会计博士专业学位首次设立！</p> <p>任何忽视现金流而激进的企业，都是找死的节奏！</p> <p>剥下会计的“画皮”－－兼论会计之道</p> <p>如同化验血液，对于企业，可以检测一下它的收现比、净现比、分红融资比！</p> <p>上市公司财务人员遭遇电信诈骗，被骗298万元，看一下被骗细节......</p> <p>企业盈利能力的五大指标！！！</p> <p>长期股权投资！！！</p> <p>让企业家勇于扩表吧！</p>","is_column":false,"is_ss_multi_pic":false,"is_bonus":false,"cover_pic":"","answer_question":false,"is_no_archive":false,"is_original_declare":false,"mp_not_show_status":false,"forbidden_comment":false,"is_private":false}