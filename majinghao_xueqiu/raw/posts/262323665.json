eward":false,"firstImg":"https://xqimg.imedao.com/18adf6a6c0971f7e3fc3bd18.png","canEdit":true,"timeBefore":"2023-09-29 13:30","longTextForIOS":false,"tagsForWeb":";","topic_pic_thumbnail_small":null,"topic_pic_thumbnail":null,"topic_pic_headOrPad":null,"reply_count":0,"meta_keywords":"{\"ip_location\":\"北京\"}","paid_mention":null,"reward_count":0,"reward_amount":0,"reward_user_count":0,"talk_count":0,"like_count":0,"video_info":null,"quote_cards":null,"promotion_pic":null,"promotion_url":null,"promotion_id":0,"mark_desc":null,"pic_sizes":[{"width":1080,"height":258},{"width":479,"height":669}],"cover_pic_size":null,"order_id":0,"tags":[],"status_industry":null,"excellent_comments":[],"notice_tag":null,"common_emotion":null,"current_stock_price":null,"new_card":null,"source_deep_link":null,"source_feed":false,"editable":true,"like_config":null,"title_ad_pic":null,"title_ad_url":null,"title_ad_deep_link":null,"answer_comment":null,"answer_count":0,"answer_users":null,"bonus_screen_name":null,"fundx_tag":null,"extend_st_feed_info":{"stock_event_time":0,"stock_event_type":null,"change_event_color":null,"is_future_event":false,"stock_event_id":null,"stock_event_message":null,"original_text_length":1131,"disputed_status":false,"excellent_status":"false"},"stock_list":null,"reply_user_images":null,"reply_user_count":0,"fundx_symbol":null,"hot_new_rank":null,"image_info_list":[{"filename":"18adf6a6c0971f7e3fc3bd18.png","width":1080,"height":258,"ocr_result":null},{"filename":"18adf6a5f0e90b803fef9dbd.png","width":479,"height":669,"ocr_result":null}],"extend_st_home_page":{"ip_location":"北京","st_mention_stock_count":0,"ai_card":null,"ai_status":false,"speech_enable":false,"speech_info":null},"censor_state":0,"forbidden_retweet":true,"recommend_cards":null,"vod_info":null,"is_answer":false,"is_refused":false,"is_ss_multi_pic":false,"is_bonus":false,"show_cover_pic":true,"legal_user_visible":false,"text":"<p>2023年9月28日下午，中央组织部有关负责同志出席财政部领导干部会议，宣布中央决定：蓝佛安同志任财政部党组书记，免去刘昆同志的财政部党组书记职务。</p> <p><img class=\"ke_img\" src=\"https://xqimg.imedao.com/18adf6a6c0971f7e3fc3bd18.png\" /></p> <p><b>此前报道</b></p> <p>中共中央决定：蓝佛安同志不再担任山西省委书记、常委、委员职务，另有任用。</p> <p><img class=\"ke_img\" src=\"https://xqimg.imedao.com/18adf6a5f0e90b803fef9dbd.png\" /></p> <p>蓝佛安同志简历</p> <p>根据公开简历，蓝佛安是财政老兵，1985年8月毕业后，第一份工作是去财政部预算司中央处先后担任办事员、科员。<b>预计经过相关程序后，蓝佛安将成为新一届中国财长。</b></p> <p><b>蓝佛安，男，汉族，</b>1962年6月生，广东惠东人，1985年8月参加工作，1985年4月加入中国共产党，大学学历，管理学硕士学位。 </p> <p>1981.09-1985.08 湖北财经学院(现中南财经政法大学)财政金融系财政专业学习 </p> <p>1985.08-1988.11 财政部预算司中央处办事员、科员 </p> <p>1988.11-1993.03 广东省财政厅预算处科员、副主任科员、主任科员 </p> <p>1993.03-1995.03 广东省财政厅预算处副处长</p> <p>1995.03-1999.03 广东省财政厅办公室主任 </p> <p>1999.03-2001.10 广东省东莞市副市长 </p> <p>2001.10-2007.04 广东省财政厅副厅长 </p> <p>2007.04-2008.03 广东省审计厅党组书记（其间：2007.09-2008.01中央党校地厅级干部进修班学习） </p> <p>2008.03-2015.03 广东省审计厅党组书记、厅长（2006.09-2009.06华南理工大学政治与公共管理学院行政管理专业研究生课程班学习，获管理学硕士学位） </p> <p>2015.03-2016.01 广东省韶关市委书记 </p> <p>2016.01-2017.03 广东省副省长 </p> <p>2017.03-2018.01 海南省委常委、省纪委书记 </p> <p>2018.01-2021.04 海南省委常委、省纪委书记、省监察委员会主任 </p> <p>2021.04-2021.06 山西省委副书记，省委教育工委书记、省委军民融合办主任（兼） </p> <p>2021.06-2022.12 山西省委副书记、省长，省政府党组书记 </p> <p>2022.12-2023.01 山西省委书记、省长，省政府党组书记 </p> <p>2023.01- 山西省委书记，省人大常委会主任</p> <p>中共十九大、二十大代表，第二十届中央委员，第十九届中央纪委委员，第十三、十四届全国人大代表。</p> <p>来源：财政部 中国新闻网</p> <p>用精炼的语言阐述深刻的财务逻辑，如文章得到您的认可，<b>希望您看完后分享到“朋友圈”或者点一下右下角的“在看”</b><b>，</b>以示鼓励。长期坚持原创不易，多次想放弃，坚持是一种信仰，专注是一种态度 ，一路陪伴，一起地老天荒，谢谢。</p>  <p><b>推荐阅读</b></p> <p><b>上市公司虚增收入与利润如何与现金流配合 ...</b></p> <p>财务报表就像是比基尼......</p> <p>让创业失败者别上失信的黑名单 目前创业...</p> <p><b>营业外收入！！！</b></p> <p>具体分析一家上市公司是否被商誉减值“掏空...</p> <p>上市公司做大利润的基本逻辑</p> <p>对于巨额商誉减值损失，要有人承担责任！</p> <p><b>量化“收割”太凶悍？涨起来又被砸下去，散...</b></p>","is_column":false,"cover_pic":"","pic":"https://xqimg.imedao.com/18adf6a6c0971f7e3fc3bd18.png,https://xqimg.imedao.com/18adf6a5f0e90b803fef9dbd.png","answer_question":false,"is_no_archive":false,"is_original_declare":false,"mp_not_show_status":false,"forbidden_comment":true,"is_private":false}