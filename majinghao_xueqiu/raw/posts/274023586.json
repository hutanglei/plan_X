3fee5b6c.jpeg","width":1080,"height":2941,"ocr_result":null},{"filename":"18ce96de05eb90813fe7294f.png","width":1080,"height":2286,"ocr_result":null},{"filename":"18ce96db860a97793fe65ee7.jpeg","width":1080,"height":1530,"ocr_result":null},{"filename":"18ce96dfbe7a56843fe6c785.jpeg","width":201,"height":201,"ocr_result":null},{"filename":"18ce96dc6f1a56713fdcb349.jpeg","width":1080,"height":1000,"ocr_result":null},{"filename":"18ce96db449af6c33fc8e458.jpeg","width":201,"height":201,"ocr_result":null},{"filename":"18ce96dee6baf6de3fac70ef.png","width":952,"height":587,"ocr_result":null},{"filename":"18ce96dcf3da27e83fe0b5ce.png","width":960,"height":914,"ocr_result":null},{"filename":"18ce96da3ebdb06c3fc76e1c.png","width":954,"height":463,"ocr_result":null},{"filename":"18ce96ddb31db07e3fbb89f0.jpeg","width":201,"height":201,"ocr_result":null}],"extend_st_home_page":{"ip_location":"北京","st_mention_stock_count":1,"ai_card":null,"ai_status":false,"speech_enable":false,"speech_info":null},"censor_state":0,"show_cover_pic":true,"legal_user_visible":false,"forbidden_retweet":false,"pic":"https://xqimg.imedao.com/18ce96d8ac8af6b03fe63021.jpeg,https://xqimg.imedao.com/18ce96d9afba27d53fe595b3.jpeg,https://xqimg.imedao.com/18ce96d96eda565a3fbbb488.jpeg,https://xqimg.imedao.com/18ce96daa37b906c3fee5b6c.jpeg,https://xqimg.imedao.com/18ce96de05eb90813fe7294f.png,https://xqimg.imedao.com/18ce96db860a97793fe65ee7.jpeg,https://xqimg.imedao.com/18ce96dfbe7a56843fe6c785.jpeg,https://xqimg.imedao.com/18ce96dc6f1a56713fdcb349.jpeg,https://xqimg.imedao.com/18ce96db449af6c33fc8e458.jpeg,https://xqimg.imedao.com/18ce96dee6baf6de3fac70ef.png,https://xqimg.imedao.com/18ce96dcf3da27e83fe0b5ce.png,https://xqimg.imedao.com/18ce96da3ebdb06c3fc76e1c.png,https://xqimg.imedao.com/18ce96ddb31db07e3fbb89f0.jpeg","recommend_cards":null,"vod_info":null,"is_answer":false,"is_refused":false,"text":"<p><b>注：因为公众号平台更改了推送规则，如果不想错过马靖昊说会计的文章，记得将我们设为“星标”，多点文末右下角的</b><b>“</b><b>在看</b><b>”</b><b>，</b><b>这样每次新文章推送才会第一时间出现在您的订阅列表里。</b></p> <p><b>星标方法</b> 点击页面左上角蓝色<b>马靖昊说会计</b>进入主页，再点主页右上角<b>&#34;...&#34;</b><b>，</b>然后选择<b>“设为星标”</b>（账号旁显示五角星标记表示成功。）</p> <p>为进一步规范和加强代扣代缴、代收代缴和委托代征(以下简称“三代”)税款手续费的管理，国家税务总局、财政部和中国人民银行联合发布<b>《关于进一步加强代扣代收代征税款手续费管理的通知》税总财务发[2023] 48号</b>（以下简称“新规定”），规定代扣、代收扣缴义务人和代征人应于<b>每年3月31日前</b>，向税务机关提交上一年度“三代”税款手续费申请相关资料，<b>扣缴义务人领取的扣缴手续费可以用于提升办税能力、奖励办税人员</b>。<b>因“三代”单位或个人自身原因，未及时提交申请的，视为自动放弃上一年度“三代”税款手续费。</b>自2023年10月1日起执行。《财政部税务总局人民银行关于进一步加强代扣代收代征税款手续费管理的通知》 (财行[2019]11号，以下简称“原规定”) 同时废止。</p> <p><img class=\"ke_img\" src=\"https://xqimg.imedao.com/18ce96d8ac8af6b03fe63021.jpeg\" /></p> <p><b>“三代”范围</b></p> <p><img class=\"ke_img\" src=\"https://xqimg.imedao.com/18ce96d9afba27d53fe595b3.jpeg\" /></p> <p><img class=\"ke_img\" src=\"https://xqimg.imedao.com/18ce96d96eda565a3fbbb488.jpeg\" /></p> <p><b>“三代”税款手续费支付比例和限额</b></p> <p><b>提示：</b><b>根据《中华人民共和国个人所得税法》第十七条：“对扣缴义务人按照所扣缴的税款，付给</b><b>百分之二</b><b>的手续费。”其他无单独文件的，按照新规定执行。</b></p> <p><img class=\"ke_img\" src=\"https://xqimg.imedao.com/18ce96daa37b906c3fee5b6c.jpeg\" /><img class=\"ke_img\" src=\"https://xqimg.imedao.com/18ce96de05eb90813fe7294f.png\" /><img class=\"ke_img\" src=\"https://xqimg.imedao.com/18ce96db860a97793fe65ee7.jpeg\" /></p> <p><img class=\"ke_img\" src=\"https://xqimg.imedao.com/18ce96dfbe7a56843fe6c785.jpeg\" /></p> <p><b>“三代”税款手续费申请时限</b></p> <p><img class=\"ke_img\" src=\"https://xqimg.imedao.com/18ce96dc6f1a56713fdcb349.jpeg\" /></p> <p><img class=\"ke_img\" src=\"https://xqimg.imedao.com/18ce96db449af6c33fc8e458.jpeg\" /></p> <p><b>如何线上申请三代手续费？</b></p> <p>以电子税务局为例，点击【我要办税】—【其他服务事项】—【其他涉税事项】—【三代手续费支付申请】，进入后选择2019年2月2日（含）及其以后点击确定按钮，进入下一步，选择开户银行、银行账号、填写经办人及联系电话，检查带出的信息（税款类型、税种、税款所属期、入库金额、支付比例、手续费金额）是否正确，确认无误后点击提交申请按钮即可。</p> <p>一、我要办税—其他服务事项</p> <p><img class=\"ke_img\" src=\"https://xqimg.imedao.com/18ce96dee6baf6de3fac70ef.png\" /></p> <p>二、其他服务事项—其他涉税事项—三代手续费支付申请</p> <p><img class=\"ke_img\" src=\"https://xqimg.imedao.com/18ce96dcf3da27e83fe0b5ce.png\" /></p> <p>三、三代手续费支付申请页面，进入后选择2019年2月2日（含）及其以后点击确定按钮，进入下一步，选择开户银行、银行账号、填写经办人及联系电话，检查带出的信息（税款类型、税种、税款所属期、入库金额、支付比例、手续费金额）是否正确，确认无误后点击提交申请按钮即可。</p> <p><img class=\"ke_img\" src=\"https://xqimg.imedao.com/18ce96da3ebdb06c3fc76e1c.png\" /></p> <p><img class=\"ke_img\" src=\"https://xqimg.imedao.com/18ce96ddb31db07e3fbb89f0.jpeg\" /></p> <p><b>常见问题</b></p> <p><b>1.收到的这部分手续费返还款要不要交税？</b></p> <p>增值税：</p> <p>依据国家税务总局12366纳税服务平台给出的回复，个人所得税手续费应按“经纪代理服务”项目缴纳增值税，如果企业是一般纳税人，税率为6%，如果企业是小规模纳税人，那么征收率为3%。</p> <p>有一些个别省份把企业收到的手续费返还收入定性为带有奖励性质的财政拨款而免征增值税。</p> <p>建议与当地所属税务机关沟通确认。</p> <p>企业所得税：</p> <p>根据《企业所得税法》和《企业所得税法实施条例》的规定，企业收到的手续费应计入当年收入总额，并按规定缴纳企业所得税。</p> <p>如果企业拿出一部分用于办税人员（财务人员）的奖励，那么这部分支出可以以工资薪金支出在税前进行扣除。</p> <p>个税：</p> <p>《财政部国家税务总局关于个人所得税若干政策问题的通知》（财税字[1994]20号）规定：个人办理代扣代缴税款手续，按规定取得的扣缴手续费，暂免征收个人所得税。</p> <p>北京税务答复：如不是个人作为扣缴义务人的情况，奖励给办税人员或其他人员都需要合并工资薪金计征个人所得税。</p> <p>个别省份的答复口径是奖励给办税人员免征个人所得税，奖励给非相关人员的，应该按照工资薪金所得计算缴纳个税。</p> <p>建议与当地所属税务机关沟通确认。</p> <p><b>2.收到返款如何进行账务处理？</b></p> <p>情况一：执行《企业会计准则》的企业，代扣个人所得税手续费应当计入“其他收益”科目，并作为其他与日常活动相关的项目在利润表的“其他收益”项目中填列。具体账务处理:</p> <p>借:银行存款</p> <p> 贷:其他收益</p> <p> 应交税费一一应交增值税(销项税额)</p> <p>情况二：执行《小企业会计准则“》的企业，根据财政部会计司发布2021年第五批企业会计准则实施问答明确:执行《小企业会计准则》的企业作为个人所得税的扣缴义务人，根据《中华人民共和国个人所得税法》收到的扣缴税款手续费，应当计入“其他收益”科目，在利润表“营业收入”项目中反映。因此，企业代扣个人所得税取得的手续费账务处理如下:</p> <p>借:银行存款</p> <p> 贷:其他收益</p> <p> 应交税费一一应交增值税</p> <p>用精炼的语言阐述深刻的财务逻辑，如文章得到您的认可，<b>希望您看完后分享到“朋友圈”或者点一下右下角的“在看”，</b>以示鼓励。长期坚持不易，多次想放弃，坚持是一种信仰，专注是一种态度 ，一路陪伴，一起地老天荒，谢谢。</p>  <p><b>推荐阅读</b></p> <p><b>应付职工薪酬！！！</b></p> <p>资产负债表日！！！</p> <p>普华永道连续14年为<a href=\"https://xueqiu.com/S/03333?from=status_stock_match\" class=\"xq_stock\">恒大</a>背书！据说，...</p> <p>“洗大澡”</p> <p>如何判断一个行业有没有投资价值，最直观的...</p> <p><b>CFO必读：我通过虚增利润而虚增的资产类项目，总结出财务造假的五重境界！</b></p> <p>对于一家企业成长性的分析！！！</p> <p>资产负债表日！！！</p>","is_column":false,"is_ss_multi_pic":false,"is_bonus":false,"cover_pic":"","answer_question":false,"is_no_archive":false,"is_original_declare":false,"mp_not_show_status":false,"forbidden_comment":false,"is_private":false}