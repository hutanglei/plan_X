7c.jpeg","width":201,"height":201,"ocr_result":null},{"filename":"198a1f630fd155443fc94d89.jpeg","width":201,"height":201,"ocr_result":null},{"filename":"198a1f63e511599e3fd3d92a.png","width":128,"height":128,"ocr_result":null}],"extend_st_home_page":{"ip_location":"北京","st_mention_stock_count":0,"ai_card":null,"ai_status":false,"speech_enable":false,"speech_info":null},"censor_state":0,"recommend_cards":null,"forbidden_retweet":false,"pic":"https://xqimg.imedao.com/198a1f623f7159983fe78d0b.jpeg,https://xqimg.imedao.com/198a1f637c2158643fe1c58c.jpeg,https://xqimg.imedao.com/198a1f62d6615ac23fc64251.png,https://xqimg.imedao.com/198a1f6397f155483fe85379.jpeg,https://xqimg.imedao.com/198a1f62f911599a3fed227c.jpeg,https://xqimg.imedao.com/198a1f630fd155443fc94d89.jpeg,https://xqimg.imedao.com/198a1f63e511599e3fd3d92a.png","vod_info":null,"is_answer":false,"is_refused":false,"text":"<p>注：因为公众号平台更改了推送规则，多多点击文末右下角留言、分享或<b>“</b><b>♥</b><b>”</b><b>，</b><b>这样每次新文章推送才会第一时间出现在您的订阅列表里。</b></p> <p><img class=\"ke_img\" src=\"https://xqimg.imedao.com/198a1f623f7159983fe78d0b.jpeg\" /></p> <p>【报表间无法弥合的撕裂，正是财务造假藏不住的底牌】上市公司的利润报告如同精心打扮的妆容，华丽夺目。但若连续几年涂抹“虚增”的粉底，那资产负债表这张素颜照，终究会泄露某些异常凸起——现金、应收账款、存货、在建工程、固定资产、无形资产……总有一处会被撑得变形，格外醒目。更致命的是，一旁经营活动现金净流量这面最诚实的镜子，将与那浓妆的净利润形成巨大反差。</p> <p><b>毛利百分之六十：</b>现在的上市公司比我们天天编假报表给银行的都牛，一般我们都不大虚增太多货币资金，上市公司是几十亿上百亿的虚增，大开眼界。</p> <p><b>马靖昊：</b>虚增货币资金真是造假造到“耍流氓”了，毕竟货币资金不能拿假币来凑数。</p> <p><b>lukilinzhou：</b>是的。1、造假在资金比较少，因为要造全套银行凭据及对账单，标准审计流程对账函证直接取自银行，中间不能让企业碰；2、造假在应收+存货+在建+固资较多，还会减少应付，真是要分散造假，考验的是现场审计认真+样本+分析水平；3、风险在于审计责任匹配不当：小朋友在现场；经理多接单，关键点位都理不清。</p> <p><b>疾风--劲草：</b>虚增就意味着要藏，既然是藏总有露出尾巴的时候！</p> <p><img class=\"ke_img\" src=\"https://xqimg.imedao.com/198a1f637c2158643fe1c58c.jpeg\" /></p> <p>【资产减值准则的用处】某上市公司的存货、商誉、应收、合同资产集体爆雷，减值准备就成了“财务洗澡”专用喷头，将以前虚增的“利润”所造成的虚增的“资产”，全现了“费用”的原形！ </p> <p>山岗0123456789：长期关注或阅读你的文章，收获满满的，对商誉奇高的公司，就不要再看下去了，避免风险隐患<img class=\"ke_img\" src=\"https://xqimg.imedao.com/198a1f62d6615ac23fc64251.png\" /></p> <p><img class=\"ke_img\" src=\"https://xqimg.imedao.com/198a1f6397f155483fe85379.jpeg\" /></p> <p>马靖昊：上市公司财务强健指标。</p> <p>1、利润含金量=经营现金流/净利润≥1。</p> <p>2、毛利率≥30%且三费受控。</p> <p>3、ROE≥15%且连续三年。</p> <p>4、负债率≤60%，流动比率≥2。</p> <p>5、行业生命周期与增速匹配。</p> <p>把这五条打印出来，下次再听到上市公司讲成长的故事时，一秒钟就能判断：这是“真成长”，还是“割韭菜”。 </p> <p>阿文小舍说财税：马老师总结的这几个财务指标都是判断企业： 盈利能力，稳健性，成长性，发展质量的重要标准。</p> <p>晨曦林中耀：老师，实战中发现：资产高，净利润低，两者不匹配的公司也很虚。还有人员工资+股权激励很高，但净利润或净资产低的公司也很可怕，单人绩效太低了。</p> <p><img class=\"ke_img\" src=\"https://xqimg.imedao.com/198a1f62f911599a3fed227c.jpeg\" /></p> <p>毛利率、净利率：</p> <p>1、毛利率＜20%：过度竞争，净利率通常＜10%，收入一滑就亏损。</p> <p>2、毛利率≥30%：有护城河，净利率≥15%，经得起折腾。</p> <p>毛利率逐年下滑：要么护城河被挖，要么行业新玩家太多。</p> <p>特别提醒：如果毛利率还行，净利率却奇低，一定是“三费（销售、管理、财务费用）”失控。一般而言，“三费”应控制在营业利润的30%以下。</p> <p><img class=\"ke_img\" src=\"https://xqimg.imedao.com/198a1f630fd155443fc94d89.jpeg\" /></p> <p><b>财务造假主要集中在资产负债表和利润表上，因为资产=负债+所有者权益+收入-费用，通过调节收入和费用的变动，来操纵利润，</b>并且只要调节收入和费用的变动，一定会影响到资产负债表的相关数据。具体手法如虚构收入、提前确认收入、推迟确认收入，多提或少提资产减值准备以调控利润，制造非经常性损益事项，会计政策和会计估计变更，关联交易非关联化等等。</p> <p><b>很快就会瘦的志英：</b>请问老师如何关联交易非关联化呢？</p> <p><b>马靖昊：</b>请你看看<a href=\"https://xueqiu.com/n/南山之秦\" target=\"_blank\">@南山之秦</a> 的回答：字面意思就能理解。比方，你跟二大爷做生意，你二大爷换了个马甲，跟外人说这不是你二大爷，其实他就是你二大爷。</p> <p><b>小林居士：</b><b>关于财务造假的本质，马靖昊老师说过，调高利润，就是费用资产化，或虚增收入；调低利润，就是资产费用化，或收入负债化。</b><b>言简意赅，八九不离十了。</b></p> <p><b>全文完，感谢您的阅读，请收藏转发，顺手点个“赞”或“</b><img class=\"ke_img\" src=\"https://xqimg.imedao.com/198a1f63e511599e3fd3d92a.png\" />”~~~~~</p>   <p><b>推荐阅读</b></p> <p><b>财政部、税务总局就《中华人民共和国增值税法实施条例(征求意见稿)》公开征求意见</b></p> <p><b>现金流量表核心看三点！</b></p> <p><b>虚增资产！！！</b></p> <p><b>上市公司造假-税费、资金流转、利益分赃、虚假分红四座大山压顶，稍有不慎便满盘皆输</b></p> <p><b>现金流量表是如何造假的？</b></p> <p><b>非常启发：在我眼中的企业毛利以及毛利率！</b></p> <p><b>ROE的缺陷</b></p> <p><b>一个家其实就是一套财报</b></p>","show_cover_pic":true,"legal_user_visible":false,"is_column":false,"is_ss_multi_pic":false,"is_bonus":false,"cover_pic":"","is_original_declare":false,"mp_not_show_status":false,"forbidden_comment":false,"answer_question":false,"is_no_archive":false,"is_private":false}